{
    "name": "metrajay",
    "version": "0.0.1",
    "scripts": {
        "watch:cljs": "API_URL=http://localhost:8787 shadow-cljs watch app",
        "watch:scss": "sass --watch src/app.scss public/css/main.css",
        "dev": "npm-run-all --parallel watch:*",
        "repl": "shadow-cljs repl app",
        "build": "sass src/app.scss public/css/main.css && shadow-cljs release app"
    },
    "devDependencies": {
        "npm-run-all": "^4.1.5",
        "shadow-cljs": "^2.26.0"
    },
    "dependencies": {
        "@headlessui/react": "^1.7.11",
        "@tailwindcss/forms": "^0.5.3",
        "autoprefixer": "^10.4.21",
        "cross-env": "^7.0.3",
        "jszip": "^3.10.1",
        "nes.css": "^2.2.1",
        "postcss": "^8.5.6",
        "postcss-cli": "^11.0.1",
        "postcss-scss": "^4.0.9",
        "react": "^18.2.0",
        "react-dom": "^18.2.0",
        "sass": "^1.93.2"
    }
}
